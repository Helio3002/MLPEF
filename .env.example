# docker-compose configuration for the MLPEF full stack.
# Copy to `.env` (gitignored) and edit. These are DEMO defaults — change every
# secret before exposing the stack to anything real.
#
#   cp .env.example .env && docker compose up --build

# --- Postgres ------------------------------------------------------------- #
POSTGRES_USER=mlpef
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mlpef

# --- Control-plane admin login (seeded on first boot) --------------------- #
# The UI logs in with these. CHANGE THE PASSWORD.
MLPEF_ADMIN_USERNAME=admin
MLPEF_ADMIN_PASSWORD=change-me-admin

# --- UI / API wiring ------------------------------------------------------ #
# The admin UI's nginx reverse-proxies the control-api under /api (SAME ORIGIN),
# so the UI needs no absolute API URL and there is NO CORS to configure: it works
# on localhost and on a Codespaces forwarded host with no rebuild. Leave this as
# /api unless you deliberately point the UI at a different API host.
VITE_API_BASE_URL=/api
# CORS only matters if something calls the control-api cross-origin DIRECTLY (the
# `npm run dev` server on :5173, or external API clients) — not for the UI above.
MLPEF_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- HITL signing key ----------------------------------------------------- #
# Leave blank for an ephemeral dev key (tokens won't verify across a control-api
# restart). For a stable demo, paste a PKCS8 Ed25519 private key PEM (one line,
# \n-escaped) sourced from a secret manager. See THREAT_MODEL.md R-8 / R-22.
MLPEF_HITL_PRIVATE_KEY_PEM=

# --- Sample agent (demo) -------------------------------------------------- #
# When BOTH are set, the seed creates the sample agent with this fixed id+key so
# the `sample-agent` demo container can authenticate with no copy/paste. This is
# a DEMO-ONLY convenience — a fixed agent credential must never ship to prod.
MLPEF_SAMPLE_AGENT_ID=sample-agent-demo
MLPEF_SAMPLE_AGENT_API_KEY=change-me-demo-agent-key-0123456789
