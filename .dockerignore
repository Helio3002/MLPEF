# Build-context excludes for the repo-root contexts (control-api, proxy).
# Keeps images small and avoids leaking local secrets / state into layers.
.git
.gitignore
.github
.vscode
.idea

# Python
**/__pycache__/
**/*.pyc
**/*.pyo
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# Node (admin-ui has its own context + .dockerignore, but exclude here too)
**/node_modules/
control-plane/admin-ui/dist/

# Local dev state / secrets — never bake these into an image
*.db
*.sqlite
*.sqlite3
.env
.env.*
!.env.example

# Docs/artifacts not needed at runtime
**/*.md
policies/**/*.wasm
